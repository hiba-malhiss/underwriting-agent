# Copy to .env and fill in. .env is never committed.

# Azure sign-in
# Local: sign in with your own account in the browser (a window opens on the first request).
# On Azure: leave both unset — the app uses its Managed Identity.
AZURE_INTERACTIVE_LOGIN=true
# Portal → Microsoft Entra ID → Overview → Tenant ID
AZURE_TENANT_ID=

# Blob Storage: Storage account → Overview → Blob service endpoint
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# The container you created in the Portal
STORAGE_CONTAINER=underwriting-documents
MAX_UPLOAD_MB=20
