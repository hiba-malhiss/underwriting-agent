# Copy to .env and fill in. .env is never committed.

# Azure sign-in
# Local: sign in with your own account in the browser (a window opens on the first request).
# On Azure: leave both unset — the app uses its Managed Identity.
AZURE_INTERACTIVE_LOGIN=true
# Portal → Microsoft Entra ID → Overview → Tenant ID
AZURE_TENANT_ID=

# Blob Storage: Storage account → Overview → Blob service endpoint
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# The container you created in the Portal
STORAGE_CONTAINER=underwriting-documents
MAX_UPLOAD_MB=20

# AI Search: Search service → Overview → Url. Optional: without it, the indexers only run on
# their schedule. Your identity needs 'Search Service Contributor' to start indexers.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# AI Search → Indexers: the indexer that reads each container (leave empty to skip)
APPLICANT_INDEXER=
REQUIREMENTS_INDEXER=

# MySQL (Flexible Server → Overview → Server name). No password: the app signs in with Entra.
MYSQL_HOST=<server>.mysql.database.azure.com
MYSQL_DATABASE=underwriting
# Locally: your Entra user principal name (Entra ID → Users → User principal name)
MYSQL_USER=

# Document Intelligence: the Foundry (AI Services) resource → Overview → Endpoint.
# Your identity needs 'Cognitive Services User' on that resource.
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# Azure OpenAI (Foundry resource → Overview → Endpoint) and the model deployment's name.
# Your identity needs 'Cognitive Services OpenAI User' on that resource.
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
